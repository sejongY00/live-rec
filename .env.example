# cp .env.example .env 후 수정

# 녹화 저장 위치 (호스트 경로). 예: /volume1/video/live
REC_DIR=./recordings
# 녹화 파일 소유자 — 호스트에서 `id` 로 확인 (Synology 첫 사용자는 보통 1026 / 100)
PUID=1000
PGID=1000
# 예약·표시 시간대
TZ=Asia/Seoul
# 웹 화면 포트
REC_WEB_PORT=8790
# 여유 공간이 이보다 적으면(GB) 녹화를 멈춘다
REC_MIN_FREE_GB=20

# ---- 웹 화면 로그인 (선택, 외부에 공개할 때) ----
# OIDC 제공자 주소 (Gitea: https://git.example.com, Authentik·Keycloak 등도 가능)
REC_OIDC_ISSUER=
# 제공자에 만든 OAuth2 앱의 클라이언트 ID (리디렉션 URI: <REC_PUBLIC_URL>/auth/callback)
REC_OIDC_CLIENT_ID=
# 브라우저로 접속하는 공개 주소. 예: https://rec.example.com
REC_PUBLIC_URL=
# 로그인을 허용할 계정 (OIDC preferred_username, 쉼표로 여러 명)
REC_ALLOWED_USERS=
